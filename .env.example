WINSTALL_APP_TAG=winstall/app-2.0.0 # Comment this will use winstall/app-latest

# Required for authentication
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here-generate-with-openssl-rand-base64-32
NEXTAUTH_TRUST_HOST=true

# Twitter OAuth 2.0 Credentials
TWITTER_CLIENT_ID=your-twitter-client-id
TWITTER_CLIENT_SECRET=your-twitter-client-secret

# Required public API origin (runtime only — not read at Docker build).
# Browser: injected as meta[name="winstall-api-base"] for direct API calls.
# Server: used for SSR/ISR when WINSTALL_API_INTERNAL_BASE is unset or empty.
# Do not use NEXT_PUBLIC_WINSTALL_API_BASE as the client address.
WINSTALL_API_BASE=http://localhost:3100

# Optional Node-only API origin for SSR/ISR (same Docker network, e.g. http://winstall-api:3100).
# Never injected into HTML. Do not use NEXT_PUBLIC_*. Empty or unset falls back to WINSTALL_API_BASE.
# WINSTALL_API_INTERNAL_BASE=http://winstall-api:3100

WINSTALL_ICON_BASE=http://localhost:3100

# Deploy in container will default use composed mongo service
MONGODB_URI=mongodb://localhost:27017/winstall

WINSTALL_BUILDER_BASE=http://localhost:3200
WINSTALL_BUILDER_WEBHOOK=http://jenkins/job/JOB_ITEM/buildWithParameters
WINSTALL_BUILDER_WEBHOOK_AUTH_ID=userid
WINSTALL_BUILDER_WEBHOOK_AUTH_SECRET=secret

# Optional: API debugging and timeout
WINSTALL_API_DEBUG=0
WINSTALL_API_TIMEOUT_MS=15000

# Node Environment
NODE_ENV=development

# Redis Configuration (Optional - falls back to in-memory cache if not configured)
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_USE_SSL=false
# REDIS_KEY=your-redis-password

# AWS S3 Configuration (Optional - for async installer file storage)
AWS_S3_BUCKET=your-s3-bucket-name
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_ACCESS_KEY_SECRET=your-aws-access-key-secret
AWS_REGION=us-east-1 # Only need for production
# AWS_ENDPOINT=http://localhost:9000 # For local MinIO, see docker-compose.dev.yml and init-minio.sh, leave empty for AWS S3
